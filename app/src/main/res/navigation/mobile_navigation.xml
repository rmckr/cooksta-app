<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.cooksta_app.ui.home.HomeFragment"
        android:label="@string/title_home">
        <action
            android:id="@+id/action_navigation_home_to_feedFragment"
            app:destination="@id/navigation_feed" />
    </fragment>
    <fragment
        android:id="@+id/navigation_search"
        android:name="com.example.cooksta_app.ui.search.SearchFragment"
        android:label="@string/title_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_navigation_search_to_feedFragment"
            app:destination="@id/navigation_feed"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/navigation_add"
        android:name="com.example.cooksta_app.ui.create.CreateFragment"
        android:label="@string/title_add"
        tools:layout="@layout/fragment_create" />
    <fragment
        android:id="@+id/navigation_shopping_list"
        android:name="com.example.cooksta_app.ui.shoppingList.ShoppingListFragment"
        android:label="@string/title_shoppingList"
        tools:layout="@layout/fragment_shopping_list" />
    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.cooksta_app.ui.profile.ProfileFragment"
        android:label="@string/title_profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_to_edit_profile"
            app:destination="@id/navigation_edit_profile"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_left"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>
    <fragment
        android:id="@+id/navigation_edit_profile"
        android:name="com.example.cooksta_app.ui.profile.EditProfileFragment"
        android:label="EditProfileFragment"
        tools:layout="@layout/fragment_edit_profile" />
    <fragment
        android:id="@+id/navigation_feed"
        android:name="com.example.cooksta_app.ui.shared.FeedFragment"
        android:label="FeedFragment"
        tools:layout="@layout/fragment_post">
        <argument
            android:name="recipeIds"
            app:argType="string[]" />
    </fragment>
</navigation>