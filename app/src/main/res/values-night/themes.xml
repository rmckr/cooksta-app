<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for night mode. -->
    <style name="Theme.CookstaApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item> <!-- Schwarz als Primärfarbe -->
        <item name="colorOnPrimary">@color/white</item> <!-- Weißer Text auf schwarzem Hintergrund -->

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/green</item> <!-- Grün als Sekundärfarbe -->
        <item name="colorOnSecondary">@color/black</item> <!-- Schwarzer Text/Icon auf grünem Hintergrund -->

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/black</item>

        <!-- Optional: Weitere Anpassungen für Navigationsleiste und Hintergrund -->
        <item name="android:navigationBarColor">@color/black</item> <!-- Schwarz für die Navigationsleiste -->
    </style>
</resources>
