<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/postCoordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageViewHomeBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/md_theme_primaryContainer"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/avatars" />

        <ImageView
            android:id="@+id/imageViewHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:srcCompat="@tools:sample/avatars" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="80dp"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:padding="16dp">

        <CheckBox
            android:id="@+id/heartButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:button="@drawable/ic_heart"
            android:scaleX="1.5"
            android:scaleY="1.5"
            app:buttonTint="@android:color/white" />

        <CheckBox
            android:id="@+id/commentButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:button="@drawable/ic_comment"
            android:scaleX="1.5"
            android:scaleY="1.5"
            app:buttonTint="@android:color/white" />

        <CheckBox
            android:id="@+id/bookmarkButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/ic_bookmark"
            android:scaleX="1.5"
            android:scaleY="1.5"
            app:buttonTint="@android:color/white" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/standard_bottom_sheet"
        style="@style/Widget.Material3.BottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/md_theme_surfaceContainerLow"
        app:behavior_hideable="false"
        app:behavior_peekHeight="80dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:shapeAppearance="@null">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Material3.HeadlineMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Titel" />

                <ImageView
                    android:id="@+id/bottomSheetArrow"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="center"
                    app:srcCompat="@drawable/ic_arrow_up" />

            </LinearLayout>

            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-48dp"
                android:alpha="0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    id="@+id/bottomSheetLikeButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="Mag ich"
                    app:icon="@drawable/ic_heart"
                    app:iconGravity="textStart" />
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Material3.Button.TonalButton.Icon"
                    id="@+id/bottomSheetSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:checkable="true"
                    android:text="Speichern"
                    app:icon="@drawable/ic_bookmark"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Zu Einkausliste hinzufügen"
                app:icon="@drawable/ic_cart_add"
                app:iconGravity="textStart" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp" />

            <com.google.android.material.tabs.TabLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/transparent">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Beschreibung"/>
                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kommentare"/>
            </com.google.android.material.tabs.TabLayout>

            <TextView
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1.Vorbereitung: Heize den Ofen auf 180 °C Ober-/Unterhitze vor und lege ein Backblech mit Backpapier aus.
2. Teig anrühren: Gib die weiche Butter, den Zucker und den braunen Zucker in eine Schüssel. Schlage die Zutaten mit einem Handmixer oder einer Küchenmaschine schaumig. Füge das Ei und den Vanilleextrakt hinzu und rühre weiter, bis eine gleichmäßige Masse entsteht.
3. Trockene Zutaten hinzufügen: Siebe das Mehl und das Backpulver in eine separate Schüssel. Vermische beides und gib es dann nach und nach zu der Butter-Zucker-Mischung. Rühre so lange, bis ein glatter Teig entsteht.
4. Schokolade einrühren: Hacke die Zartbitterschokolade in kleine Stücke und hebe sie unter den Teig.
5. Kekse formen: Mit einem Teelöffel nimm portionsweise Teig und forme kleine Kugeln. Lege sie mit ausreichend Abstand auf das vorbereitete Backblech. Die Kekse laufen beim Backen etwas auseinander, daher sollte der Abstand groß genug sein.
6. Backen: Backe die Kekse für etwa 10-12 Minuten, bis sie goldbraun sind. Lass sie dann kurz abkühlen, bevor du sie vorsichtig vom Blech nimmst.
7. Genießen: Die Schokoladenkekse sind noch warm besonders lecker. Lass sie vollständig auskühlen und bewahre sie in einer luftdichten Dose auf, wenn du sie später genießen möchtest." />
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>